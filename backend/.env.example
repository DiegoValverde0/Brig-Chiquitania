# Copiar a .env para desarrollo local (npm run start:dev)
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USER=chiquitania
DB_PASSWORD=chiquitania_dev
DB_NAME=chiquitania_db
# Solo en desarrollo. En producción se usarán migraciones.
DB_SYNCHRONIZE=true

# RNF-08: clave AES-256 en base64 (32 bytes): `openssl rand -base64 32`. Obligatoria con NODE_ENV=production;
# en desarrollo, si falta, se usa una clave de ejemplo pública. Si se pierde, los datos cifrados no se recuperan.
# CLAVE_CIFRADO=
# Fotos cifradas (HU-1.1)
EVIDENCIAS_DIR=almacen/evidencias

# HU-1.3: pasarela SMS ("simulado" hasta contratar proveedor), secreto del webhook y número de la central
SMS_PROVEEDOR=simulado
# SMS_WEBHOOK_SECRETO=   (obligatorio en producción; en desarrollo: secreto-sms-solo-desarrollo)
SMS_NUMERO_CENTRAL=+59170000000

# Bolt 4 (RF-11): Web Push al jefe de brigada. Obligatorias en producción (`node dist/generar-vapid mailto:…`);
# en desarrollo, si faltan, se generan una vez en almacen/vapid-dev.json.
# VAPID_PUBLICA=
# VAPID_PRIVADA=
VAPID_CONTACTO=mailto:coed@example.org
# Minutos sin leer la orden (push) antes de enviar el SMS de respaldo (decisión 7.1 del PO)
SMS_RESPALDO_MIN=3

# Opcional: la API también sirve la app web (en el VPS la sirve nginx)
FRONTEND_DIR=../frontend/app
